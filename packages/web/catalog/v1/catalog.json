{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bassemZohdy/app-mixer/main/packages/web/catalog/v1/catalog.json",
  "catalogId": "https://raw.githubusercontent.com/bassemZohdy/app-mixer/main/packages/web/catalog/v1/catalog.json",
  "components": {
    "Text": {
      "type": "object",
      "properties": {
        "text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          ]
        },
        "variant": {
          "enum": [
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "caption",
            "body"
          ]
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "Column": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 1000
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 1000
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "properties": {
        "child": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "child"
      ],
      "additionalProperties": false
    },
    "TextField": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/.+"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "variant": {
          "enum": [
            "shortText",
            "longText"
          ]
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "Button": {
      "type": "object",
      "properties": {
        "child": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "variant": {
          "enum": [
            "default",
            "primary",
            "borderless"
          ]
        },
        "action": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "context": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "pattern": "^/"
                          }
                        },
                        "required": [
                          "path"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "child",
        "action"
      ],
      "additionalProperties": false
    }
  }
}
