{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "title": "App Mixer operations",
  "uid": "app-mixer-operations",
  "tags": ["app-mixer"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [{"name": "job", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(app_mixer_data_plane_start_time_seconds, job)", "refresh": 2, "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}}]},
  "panels": [
    {"id": 1, "type": "row", "title": "Data Plane", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},
    {"id": 2, "type": "timeseries", "title": "Requests per second by route and status class", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1}, "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (route, status_class) (rate(app_mixer_data_plane_requests_total{job=~\"$job\"}[5m]))", "legendFormat": "{{route}} {{status_class}}"}]},
    {"id": 3, "type": "timeseries", "title": "Error ratio (5xx of completed)", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (job) (rate(app_mixer_data_plane_requests_total{status_class=\"5xx\",job=~\"$job\"}[5m])) / sum by (job) (rate(app_mixer_data_plane_requests_total{outcome=\"completed\",job=~\"$job\"}[5m]))", "legendFormat": "{{job}}"}]},
    {"id": 4, "type": "timeseries", "title": "Application request latency p50 / p99", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.5, sum by (job, le) (rate(app_mixer_data_plane_request_duration_seconds_bucket{route=\"application\",outcome=\"completed\",job=~\"$job\"}[5m])))", "legendFormat": "p50 {{job}}"},
        {"refId": "B", "expr": "histogram_quantile(0.99, sum by (job, le) (rate(app_mixer_data_plane_request_duration_seconds_bucket{route=\"application\",outcome=\"completed\",job=~\"$job\"}[5m])))", "legendFormat": "p99 {{job}}"}]},
    {"id": 5, "type": "stat", "title": "Served publication version", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 4, "w": 6, "x": 0, "y": 9},
      "targets": [{"refId": "A", "expr": "app_mixer_data_plane_publication_version{job=~\"$job\"}", "legendFormat": "{{job}} {{instance}}"}]},
    {"id": 6, "type": "stat", "title": "Draining", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 4, "w": 6, "x": 6, "y": 9}, "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "serving"}, "1": {"text": "draining", "color": "orange"}}}]}, "overrides": []},
      "targets": [{"refId": "A", "expr": "app_mixer_data_plane_draining{job=~\"$job\"}", "legendFormat": "{{job}} {{instance}}"}]},
    {"id": 7, "type": "stat", "title": "Uptime", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 4, "w": 6, "x": 12, "y": 9}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "time() - app_mixer_data_plane_start_time_seconds{job=~\"$job\"}", "legendFormat": "{{job}} {{instance}}"}]},
    {"id": 8, "type": "row", "title": "Agents", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}, "panels": []},
    {"id": 9, "type": "timeseries", "title": "Durable runs by status", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "targets": [{"refId": "A", "expr": "sum by (status) (app_mixer_agent_runs{archived=\"false\"})", "legendFormat": "{{status}}"}]},
    {"id": 10, "type": "timeseries", "title": "Journaled actions by status (uncertain and dispatching need an operator)", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "targets": [{"refId": "A", "expr": "sum by (action_status) (app_mixer_agent_action_backlog)", "legendFormat": "{{action_status}}"}]},
    {"id": 11, "type": "timeseries", "title": "Oldest overdue and due schedule age", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "max by (kind) (app_mixer_agent_oldest_overdue_seconds)", "legendFormat": "overdue {{kind}}"},
        {"refId": "B", "expr": "max(app_mixer_agent_oldest_schedule_due_seconds)", "legendFormat": "due schedule"}]},
    {"id": 12, "type": "stat", "title": "Overdue runs and due schedules", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 4, "w": 8, "x": 0, "y": 22},
      "targets": [
        {"refId": "A", "expr": "sum(app_mixer_agent_overdue_runs)", "legendFormat": "overdue runs"},
        {"refId": "B", "expr": "sum(app_mixer_agent_schedules{state=\"due\"})", "legendFormat": "due schedules"}]}
  ]
}
