{
  "name": "app-mixer",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @app-mixer/web && npm run build --workspace @app-mixer/core && npm run build --workspaces",
    "test": "npm run build && node scripts/run-tests.mjs",
    "docs": "node scripts/docs-index.mjs",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "previews": "node scripts/sync-editor-previews.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
