FROM node:22.23.5-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb AS build
WORKDIR /app
COPY package*.json tsconfig.base.json ./
COPY packages ./packages
# Install and build only the workspaces the Data Plane loads, so the agent package's dependencies (LangChain, provider SDKs, ...) stay out of the image.
RUN npm ci --workspace @app-mixer/core --workspace @app-mixer/web  && npm run build --workspace @app-mixer/web && npm run build --workspace @app-mixer/shared && npm run build --workspace @app-mixer/core  && npm prune --omit=dev --workspace @app-mixer/core --workspace @app-mixer/web

FROM node:22.23.5-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb
# The pinned Node base shipped libpam 1.5.2-6+deb12u2 (CVE-2025-6020, HIGH) before upstream rebuilt it, so only those packages are upgraded here, as root and before the package managers go.
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade libpam0g libpam-modules libpam-modules-bin libpam-runtime && rm -rf /var/lib/apt/lists/*
# The runtime only executes node, so the package managers the base image ships are removed: Node 22 ships npm 10, whose bundled packages carry HIGH vulnerabilities the image scan refuses, and corepack and yarn are not used either.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/core/package.json ./packages/core/package.json
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/packages/web/package.json ./packages/web/package.json
COPY --from=build /app/packages/web/dist ./packages/web/dist
COPY deploy/kubernetes/data-plane.mjs ./deploy/kubernetes/data-plane.mjs
USER 1000:1000
EXPOSE 3002
# Liveness for Compose and plain Docker: the Data Plane's listener (TLS or plain) accepts connections. Kubernetes uses its own probes.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["node", "-e", "require('net').connect(Number(process.env.DATA_PORT||3002),'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"]
CMD ["node", "deploy/kubernetes/data-plane.mjs"]
