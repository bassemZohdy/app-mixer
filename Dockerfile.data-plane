FROM node:26.13.0-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68 AS build
WORKDIR /app
COPY package*.json tsconfig.base.json ./
COPY packages ./packages
# Install and build only the workspaces the Data Plane loads, so the agent package's dependencies (LangChain, provider SDKs, ...) stay out of the image.
RUN npm ci --workspace @app-mixer/core --workspace @app-mixer/web  && npm run build --workspace @app-mixer/web && npm run build --workspace @app-mixer/core  && npm prune --omit=dev --workspace @app-mixer/core --workspace @app-mixer/web

FROM node:26.13.0-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/core/package.json ./packages/core/package.json
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/packages/web/package.json ./packages/web/package.json
COPY --from=build /app/packages/web/dist ./packages/web/dist
COPY deploy/kubernetes/data-plane.mjs ./deploy/kubernetes/data-plane.mjs
USER 1000:1000
EXPOSE 3002
# Liveness for Compose and plain Docker: the Data Plane's listener (TLS or plain) accepts connections. Kubernetes uses its own probes.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["node", "-e", "require('net').connect(Number(process.env.DATA_PORT||3002),'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"]
CMD ["node", "deploy/kubernetes/data-plane.mjs"]
